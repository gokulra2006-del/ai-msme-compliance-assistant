PORT=5000
MONGODB_URI=mongodb://localhost:27017/msme_compliance
JWT_SECRET=supersecretkey

# AI Provider Configuration
# Options: "openrouter", "nvidia-grok", "google"
AI_PROVIDER=openrouter

# OpenRouter API Key
# Get from: https://openrouter.ai/dashboard
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model (optional - defaults to gpt-3.5-turbo)
# Examples: gpt-4, gpt-3.5-turbo, claude-3-opus, mistral-7b-instruct
OPENROUTER_MODEL=gpt-3.5-turbo

# NVIDIA Grok API Key (optional)
# Get from: https://build.nvidia.com/
NVIDIA_GROK_API_KEY=your_nvidia_grok_api_key_here

# Google Gemini API Key (fallback)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Configuration
# Local: mongodb://localhost:27017/msme_compliance
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/database
MONGODB_DATABASE=msme_compliance

# Node Environment
NODE_ENV=development
